{
  "name": "@promethea/identity",
  "version": "5.2.3",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./server-init": {
      "types": "./dist/server-init.d.ts",
      "import": "./dist/server-init.js",
      "default": "./dist/server-init.js"
    },
    "./*": "./dist/*"
  },
  "scripts": {
    "build": "tsc --build --verbose",
    "dev": "tsc --watch --preserveWatchOutput"
  },
  "dependencies": {
    "next": "14.2.33",
    "@promethea/lib": "file:../lib"
  },
  "peerDependencies": {
    "react": "18.3.1"
  },
  "devDependencies": {
    "@types/react": "18.3.3",
    "typescript": "^5.0.0"
  }
}