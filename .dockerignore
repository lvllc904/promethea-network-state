# Exclude heavy directories and files from Docker build context
node_modules/
**/node_modules/
# Exclude Next.js build outputs but allow compiler cache for speedups
packages/app/.next/*
!packages/app/.next/cache/
!packages/app/.next/standalone/
!packages/app/.next/standalone/**
!packages/app/.next/static/
!packages/app/.next/static/**
.firebase/
**/.firebase/
.gemini/
**/.gemini/
.dist/
**/.dist/
.dist/
**/.dist/
**/dist/
**/tsconfig.tsbuildinfo
*.log
*.pdf
.git/
